<https://w3id.org/laad/tesauro/entidad/real-audiencia> a skos:Concept ; skos:inScheme tes:entidades ; skos:broader <https://w3id.org/laad/tesauro/entidad/institucion> ;
    skos:prefLabel "Real Audiencia"@es ;
    skos:definition "Tribunal superior del distrito (Cusco, desde 1787)."@es ;
