<https://w3id.org/laad/tesauro/entidad/provincia> a skos:Concept ; skos:inScheme tes:entidades ; skos:topConceptOf tes:entidades ;
    skos:prefLabel "provincia"@es ;
    skos:definition "Demarcación territorial nombrada como provincia (uso colonial tardío o republicano)."@es ;
    skos:example "UT20: «provincia de Urubamba»"@es ;
    dct:created "2026-11-13"^^xsd:date ; prov:wasAttributedTo <https://w3id.org/laad/id/agente/claude-opus-5-5> ; dct:source <https://w3id.org/laad/id/arc/expediente/cc-14-18> ;
