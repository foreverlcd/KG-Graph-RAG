<https://w3id.org/laad/tesauro/entidad/ministerio-fiscal> a skos:Concept ; skos:inScheme tes:entidades ; skos:broader <https://w3id.org/laad/tesauro/entidad/institucion> ;
    skos:prefLabel "Ministerio Fiscal"@es ;
    skos:definition "El oficio del fiscal como institución."@es ;
    skos:example "UT10: «el Minis terio Fiscal»"@es ;
    dct:created "2026-11-13"^^xsd:date ; prov:wasAttributedTo <https://w3id.org/laad/id/agente/claude-opus-5-5> ; dct:source <https://w3id.org/laad/id/arc/expediente/cc-14-18> ;
