#################################################################
pol:afirma a skos:Concept ; skos:inScheme tes:polaridades ; skos:topConceptOf tes:polaridades ; skos:prefLabel "afirma"@es .
pol:niega a skos:Concept ; skos:inScheme tes:polaridades ; skos:topConceptOf tes:polaridades ; skos:prefLabel "niega"@es .

#################################################################
# 8. Fundamento de conocimiento invocado (lo que el propio afirmante dice sobre cómo sabe)
#################################################################
fun:vista a skos:Concept ; skos:inScheme tes:fundamentos ; skos:topConceptOf tes:fundamentos ; skos:prefLabel "lo vio"@es ;
    skos:hiddenLabel "con mis ojos"@es .
fun:oidas a skos:Concept ; skos:inScheme tes:fundamentos ; skos:topConceptOf tes:fundamentos ; skos:prefLabel "de oídas"@es ;
    skos:definition "Invoca lo que otro le dijo («porque se lo dijo»)."@es .
fun:sospecha a skos:Concept ; skos:inScheme tes:fundamentos ; skos:topConceptOf tes:fundamentos ; skos:prefLabel "sospecha"@es .
fun:notoriedad a skos:Concept ; skos:inScheme tes:fundamentos ; skos:topConceptOf tes:fundamentos ; skos:prefLabel "notoriedad"@es ;
    skos:hiddenLabel "Es notorio"@es .
fun:no-consta a skos:Concept ; skos:inScheme tes:fundamentos ; skos:topConceptOf tes:fundamentos ; skos:prefLabel "declara que no le consta"@es .
fun:experiencia-propia a skos:Concept ; skos:inScheme tes:fundamentos ; skos:topConceptOf tes:fundamentos ; skos:prefLabel "lo padeció o hizo él mismo"@es .
fun:actuado a skos:Concept ; skos:inScheme tes:fundamentos ; skos:topConceptOf tes:fundamentos ; skos:prefLabel "resulta de lo actuado"@es ;
    skos:definition "Fundamento invocado por una autoridad: las diligencias del expediente."@es .
fun:no-indica a skos:Concept ; skos:inScheme tes:fundamentos ; skos:topConceptOf tes:fundamentos ; skos:prefLabel "no lo indica"@es .

