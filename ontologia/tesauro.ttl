# 9. Fuerza institucional (derivada del tipo de actuación y del rol; nunca un valor de verdad)
#################################################################
fza:testimonial a skos:Concept ; skos:inScheme tes:fuerzas ; skos:topConceptOf tes:fuerzas ; skos:prefLabel "testimonial"@es .
fza:de-parte a skos:Concept ; skos:inScheme tes:fuerzas ; skos:topConceptOf tes:fuerzas ; skos:prefLabel "alegación de parte"@es .
fza:informativa a skos:Concept ; skos:inScheme tes:fuerzas ; skos:topConceptOf tes:fuerzas ; skos:prefLabel "informativa"@es .
fza:dictaminadora a skos:Concept ; skos:inScheme tes:fuerzas ; skos:topConceptOf tes:fuerzas ; skos:prefLabel "dictaminadora"@es .
fza:resolutiva a skos:Concept ; skos:inScheme tes:fuerzas ; skos:topConceptOf tes:fuerzas ; skos:prefLabel "resolutiva"@es ;
    skos:scopeNote "Fuerza jurídica dentro del proceso: obliga a las partes, no hace verdadero lo resuelto para el historiador."@es .
fza:fedataria a skos:Concept ; skos:inScheme tes:fuerzas ; skos:topConceptOf tes:fuerzas ; skos:prefLabel "fedataria"@es ;
    skos:definition "Da fe de que una actuación ocurrió (escribano o juez con testigos)."@es .

