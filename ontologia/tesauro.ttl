cre:falso a skos:Concept ; skos:inScheme tes:creencias ; skos:topConceptOf tes:creencias ; skos:prefLabel "falso"@es .
cre:indeterminado a skos:Concept ; skos:inScheme tes:creencias ; skos:topConceptOf tes:creencias ; skos:prefLabel "indeterminado"@es .

#################################################################
# 11. Tipos documentales y de soporte
#################################################################
doc:seccion a skos:Concept ; skos:inScheme tes:documentos ; skos:topConceptOf tes:documentos ; skos:prefLabel "sección"@es ;
    skos:definition "Nivel del catálogo del ARC entre fondo y serie (p. ej. Causas Criminales)."@es .
doc:legajo a skos:Concept ; skos:inScheme tes:documentos ; skos:topConceptOf tes:documentos ; skos:prefLabel "legajo"@es ;
    skos:definition "Unidad de instalación que agrupa expedientes; su numeración es la signatura del catálogo."@es .
doc:pieza a skos:Concept ; skos:inScheme tes:documentos ; skos:topConceptOf tes:documentos ; skos:prefLabel "pieza documental"@es ;
    skos:definition "Documento singular dentro del expediente, producido en una actuación."@es .
doc:folio a skos:Concept ; skos:inScheme tes:documentos ; skos:topConceptOf tes:documentos ; skos:prefLabel "folio"@es .
doc:recto a skos:Concept ; skos:inScheme tes:documentos ; skos:broader doc:folio ; skos:prefLabel "recto"@es .
doc:vuelto a skos:Concept ; skos:inScheme tes:documentos ; skos:broader doc:folio ; skos:prefLabel "vuelto"@es .
doc:transcripcion-paleografica a skos:Concept ; skos:inScheme tes:documentos ; skos:topConceptOf tes:documentos ; skos:prefLabel "transcripción paleográfica"@es .
doc:tramo a skos:Concept ; skos:inScheme tes:documentos ; skos:topConceptOf tes:documentos ; skos:prefLabel "tramo de transcripción"@es ;
    skos:definition "Segmento de la transcripción entre separadores '#' y marcas de folio explícitas (docs/01_materiales.md §2)."@es .

#################################################################
