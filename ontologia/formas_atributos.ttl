# Formas SHACL de DOMINIO Y RANGO de los atributos — GENERADO por scripts/atributos.py desde datos/atributos.csv.
# No editar a mano. Se cargan junto a ontologia/formas.ttl (laad.validacion.grafo_formas).
# Cada forma toma las afirmaciones (crm:E13) de UN atributo y exige que su sujeto (P140) y su valor (P141) tengan
# como rdf:type directo una de las clases que el mapeo emite para los tipos admitidos en el CSV.

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix crm:   <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix ohac:  <https://w3id.org/laad/ohac#> .

<https://w3id.org/laad/ohac#AtributoForma-autenticidad-firma> a sh:NodeShape ;
    rdfs:comment "atr:autenticidad-firma — sujeto: pieza; valor: persona."@es ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { ?this <http://www.cidoc-crm.org/cidoc-crm/P177_assigned_property_of_type> <https://w3id.org/laad/tesauro/atributo/autenticidad-firma> }""" ] ;
    sh:property [ sh:path ( crm:P140_assigned_attribute_to rdf:type ) ;
        sh:qualifiedValueShape [ sh:in ( <https://www.ica.org/standards/RiC/ontology#Record> ) ] ; sh:qualifiedMinCount 1 ;
        sh:message "atr:autenticidad-firma: el sujeto de la afirmación no es de un tipo admitido (pieza)."@es ] ;
    sh:property [ sh:path ( crm:P141_assigned rdf:type ) ;
        sh:qualifiedValueShape [ sh:in ( <https://personsincontext.org/model#PersonObservation> ) ] ; sh:qualifiedMinCount 1 ;
        sh:message "atr:autenticidad-firma: el valor de la afirmación no es de un tipo admitido (persona)."@es ] .

<https://w3id.org/laad/ohac#AtributoForma-calificacion-de-conducta> a sh:NodeShape ;
    rdfs:comment "atr:calificacion-de-conducta — sujeto: grupo, persona; valor: literal."@es ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { ?this <http://www.cidoc-crm.org/cidoc-crm/P177_assigned_property_of_type> <https://w3id.org/laad/tesauro/atributo/calificacion-de-conducta> }""" ] ;
    sh:property [ sh:path ( crm:P140_assigned_attribute_to rdf:type ) ;
        sh:qualifiedValueShape [ sh:in ( <https://personsincontext.org/model#PersonObservation> <https://w3id.org/roar#Observation> ) ] ; sh:qualifiedMinCount 1 ;
        sh:message "atr:calificacion-de-conducta: el sujeto de la afirmación no es de un tipo admitido (grupo, persona)."@es ] ;
    sh:property [ sh:path ( crm:P141_assigned rdf:type ) ;
        sh:qualifiedValueShape [ sh:in ( <http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object> ) ] ; sh:qualifiedMinCount 1 ;
        sh:message "atr:calificacion-de-conducta: el valor de la afirmación no es de un tipo admitido (literal)."@es ] .

