# Afirmaciones (capa 3) con TODAS sus facetas: quién, con qué rol, ante quién, quién firma la pieza, tipo de
# actuación, fecha escrita, sujeto, atributo, valor, polaridad, fundamento, fuerza, cita, tramo y folio.
# Parámetros (bloque VALUES insertado en #PARAMETROS por laad.consulta): ?atributo, ?sujeto, ?pieza_iri,
# ?filtroEntidad (reconstrucción de capa 4: afirmaciones cuyo sujeto deriva en ella), ?filtroAfirmante
# (reconstrucción de capa 4: afirmaciones hechas por cualquiera de sus menciones).
SELECT ?a ?aid ?afirmante ?afirmanteR ?rolAf ?pieza ?tipoAct ?fecha ?ante ?firmantes ?sujetoLabel ?atributo ?atrLabel
       ?valor ?valorLabel ?pol ?fundamento ?fuerza ?cita ?tramo ?folio ?nota ?eliptico ?entidad ?valorEntidad
WHERE {
  #PARAMETROS
  ?a a crm:E13_Attribute_Assignment ; rdfs:label ?aid ;
     crm:P177_assigned_property_of_type ?atributo ; crm:P140_assigned_attribute_to ?sujeto ; crm:P141_assigned ?valor ;
     crm:P9i_forms_part_of ?act ; crm:P14_carried_out_by ?af .
  ?atributo skos:prefLabel ?atrLabel .
  ?af rdfs:label ?afirmante .
  OPTIONAL { SELECT ?af (GROUP_CONCAT(DISTINCT ?rl; separator=" | ") AS ?afirmanteR) WHERE {
      ?rp prov:wasDerivedFrom ?af ; a picom:PersonReconstruction ; rdfs:label ?rl } GROUP BY ?af }
  ?pc crm:P01_has_domain ?a ; crm:P02_has_range ?af ; crm:P14.1_in_the_role_of ?rolC . ?rolC skos:prefLabel ?rolAf .
  ?a crm:P2_has_type ?polC . ?polC skos:inScheme tes:polaridades ; skos:prefLabel ?pol .
  ?a crm:P2_has_type ?funC . ?funC skos:inScheme tes:fundamentos ; skos:prefLabel ?fundamento .
  ?a crm:P2_has_type ?fzaC . ?fzaC skos:inScheme tes:fuerzas ; skos:prefLabel ?fuerza .
  ?act crm:P94_has_created ?pz ; crm:P2_has_type ?taC . ?taC skos:inScheme tes:actuaciones ; skos:prefLabel ?tipoAct .
  ?pz rdfs:label ?pieza . BIND (?pz AS ?pieza_iri)
  FILTER (!BOUND(?filtroEntidad) || EXISTS { ?filtroEntidad prov:wasDerivedFrom ?sujeto })
  FILTER (!BOUND(?filtroAfirmante) || EXISTS { ?filtroAfirmante prov:wasDerivedFrom ?af })
  OPTIONAL { ?pz rico:hasCreationDate/rico:expressedDate ?fecha }
  OPTIONAL { SELECT ?act (GROUP_CONCAT(DISTINCT ?recL; separator=" / ") AS ?ante) WHERE {
      ?pr crm:P01_has_domain ?act ; crm:P02_has_range ?rec ; crm:P14.1_in_the_role_of ?rr .
      ?rr skos:broader* rol:receptor . ?rec rdfs:label ?recL } GROUP BY ?act }
  OPTIONAL { SELECT ?act (GROUP_CONCAT(DISTINCT ?fL; separator=" / ") AS ?firmantes) WHERE {
      ?pf crm:P01_has_domain ?act ; crm:P02_has_range ?fi ; crm:P14.1_in_the_role_of ?fr .
      ?fr skos:broader* rol:firmante . ?fi rdfs:label ?fL } GROUP BY ?act }
  OPTIONAL { ?sujeto rdfs:label ?sujetoLabel }
  OPTIONAL { ?valor skos:prefLabel ?vl1 } OPTIONAL { ?valor rdfs:label ?vl2 }
  OPTIONAL { ?valor crm:P190_has_symbolic_content ?vl3 } OPTIONAL { ?valor crm:P1_is_identified_by/crm:P190_has_symbolic_content ?vl4 }
  BIND (COALESCE(?vl1, ?vl3, ?vl4, ?vl2) AS ?valorLabel)
  ?an oa:hasBody ?a ; oa:hasTarget ?tg . ?tg oa:hasSource ?tr ; oa:hasSelector ?qs .
  ?qs a oa:TextQuoteSelector ; oa:exact ?cita . ?tr rdfs:label ?tramo .
  OPTIONAL { ?tr rico:isOrWasDerivedFromInstantiation ?fo . ?fo rico:title ?folio }
  OPTIONAL { ?a crm:P3_has_note ?nota }
  BIND (EXISTS { ?a crm:P2_has_type <https://w3id.org/laad/tesauro/anotacion/sujeto-eliptico> } AS ?eliptico)
  OPTIONAL { ?entidad prov:wasDerivedFrom ?sujeto . FILTER NOT EXISTS { ?entidad a crminf:I4_Proposition_Set } }
  OPTIONAL { ?valorEntidad prov:wasDerivedFrom ?valor }
}
ORDER BY ?pieza ?aid
