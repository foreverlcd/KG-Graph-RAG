# Menciones (capa 2) agrupadas por una reconstrucción (capa 4): grafía tal como está escrita, tramo y pieza.
# Parámetros: ?filtroEntidad (la reconstrucción) y, opcional, ?expediente (IRI del expediente: una reconstrucción
# puede reunir menciones de varios). ?exp es el identificador del expediente de cada mención.
SELECT ?mid ?texto ?tramo ?pieza ?tipoAct ?cita ?exp WHERE {
  #PARAMETROS
  ?filtroEntidad prov:wasDerivedFrom ?m .
  ?m rdfs:label ?texto ; (prov:hadPrimarySource|roar:documentedIn) ?pz . ?pz rdfs:label ?pieza .
  ?act crm:P94_has_created ?pz ; crm:P2_has_type ?ta . ?ta skos:inScheme tes:actuaciones ; skos:prefLabel ?tipoAct .
  ?an oa:hasBody ?m ; oa:hasTarget ?tg . ?tg oa:hasSource/rdfs:label ?tramo ; oa:hasSelector/oa:exact ?cita .
  BIND (STRAFTER(STR(?m), "/mencion/") AS ?mid)
  BIND (STRBEFORE(STRAFTER(STR(?m), STR(id:)), "/mencion/") AS ?exp)
  FILTER (!BOUND(?expediente) || EXISTS { ?pz rico:hasOrHadInstantiation/rico:isOrWasComponentOf/rico:isOrWasInstantiationOf ?expediente })
}
ORDER BY ?exp ?tramo ?mid
