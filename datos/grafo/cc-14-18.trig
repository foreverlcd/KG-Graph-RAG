<https://w3id.org/laad/grafo/argumentacion/R-chuquitapa-1780-pariente> {
    <https://w3id.org/laad/id/creencia/R-chuquitapa-1780-pariente> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-chuquitapa-1780-pariente> ;
        crminf:J5_holds_to_be "posible" .

    <https://w3id.org/laad/id/inferencia/R-chuquitapa-1780-pariente> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-opus-5-5> ;
        crm:P17_was_motivated_by <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT11-003>,
            <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT11-004>,
            <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT14-006>,
            <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT14-007> ;
        crm:P3_has_note "Hipótesis rival de R-chuquitapa para las tres menciones que atribuyen al cacique hechos anteriores a 1780. Que el mismo individuo fuera agitador antes de la rebelión, coronel o comisionado de Túpac Amaru y, 26 años después, cacique y recaudador tras la represión de 1781–1784 no es imposible, pero es llamativo; los testigos son hostiles al cacique y Cano rebaja su propia certificación («Comisionado por este y no coronel», UT11). El texto no nombra a ningún pariente: es una inferencia, no un dato. Creada tras la auditoría I (2026-11-13), como propuesta del modelo."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-chuquitapa-1780-pariente/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-chuquitapa-1780-pariente> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-opus-5-5> .

    <https://w3id.org/laad/id/inferencia/R-chuquitapa-1780-pariente/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-13"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-13"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-chuquitapa-1780-pariente> a crminf:I4_Proposition_Set .
}

<https://w3id.org/laad/grafo/argumentacion/R-ayllu-tinta> {
    <https://w3id.org/laad/id/inferencia/R-ayllu-tinta> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-opus-5-5> ;
        crm:P3_has_note "Ayllu del pueblo de Tinta donde la averiguación tuvo como resultado «el descubrimiento de cuarenta y cuatro tributarios en el Ayllu Tinta y siete en el Ayllu nominado Uchu» (UT05); los denunciados fueron 51 en total. Lo nombran también la carátula («casique del Ayllo Tinta»), la certificación de Orue («los Indios del Ayllu de tinta») y el informe del subdelegado («Ayllus Tinta y Ucho», «Ayllos Tinta, y Ucho», «citados Ayllos Tinta y Ucho»). No se fusiona con el pueblo, el partido ni la compañía de Tinta. Sin entrada en HGIS (que no registra ayllus). Revisada tras la auditoría I (2026-11-13)."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-ayllu-tinta/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-ayllu-tinta> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-opus-5-5> .

    <https://w3id.org/laad/id/creencia/R-ayllu-tinta> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-ayllu-tinta> ;
        crminf:J5_holds_to_be "verdadero" .

    <https://w3id.org/laad/id/inferencia/R-ayllu-tinta/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-13"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-13"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-ayllu-tinta> a crminf:I4_Proposition_Set .
}

