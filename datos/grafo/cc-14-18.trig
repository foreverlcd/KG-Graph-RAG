    <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT09-505/valor> a crm:E33_Linguistic_Object ;
        crm:P190_has_symbolic_content "ceparandolo en caso necesario que altas leguas en contrario fuera del pueblo" .

    <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT09-506/valor> a crm:E33_Linguistic_Object ;
