<https://w3id.org/laad/grafo/argumentacion/R-quinones-real-no-residente> {
    <https://w3id.org/laad/id/inferencia/R-quinones-real-no-residente> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-opus-5-5> ;
        crm:P17_was_motivated_by <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT17-002> ;
        crm:P3_has_note "El juez, parte interesada, solo dice que «no hay tal hombre en el pueblo de Tinta», lo que no excluye a alguien de fuera del pueblo. A favor de un autor distinto de Santiago Cazorla: P03 distingue «mi puerta» de «la puerta de don Santiago Cazorla» (UT02). Creada tras la auditoría I (2026-11-13), como propuesta del modelo."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-quinones-real-no-residente/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-quinones-real-no-residente> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-opus-5-5> .

    <https://w3id.org/laad/id/creencia/R-quinones-real-no-residente> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-quinones-real-no-residente> ;
        crminf:J5_holds_to_be "posible" .

    <https://w3id.org/laad/id/inferencia/R-quinones-real-no-residente/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-13"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-13"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-quinones-real-no-residente> a crminf:I4_Proposition_Set .
}

<https://w3id.org/laad/grafo/argumentacion/R-prision> {
    <https://w3id.org/laad/id/creencia/R-prision> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-prision> ;
        crminf:J5_holds_to_be "verdadero" .

    <https://w3id.org/laad/id/inferencia/R-prision> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-opus-5-5> ;
        crm:P17_was_motivated_by <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT18-002> ;
        crm:P3_has_note "La afirman el denunciante («yo me mantuve dos días preso», UT06) y el subdelegado que la ordenó («lo mande llevar a la cárcel», UT18); la corroboran la vista fiscal (P07), Cano en P18 («ponerlo en la caecel a Guancachoque») y el declarante de P19 («estando en la carcel aquel»). Ambas partes coinciden en la cronología («al siguiente día que prove la ocultación», UT05; «concluida el dia anterior la numeración», UT17); discrepan en la duración (PC11) y en la causa (venganza según el denunciante, insulto al recaudador según Mata), no en el hecho. Revisada tras la auditoría I (2026-11-13)."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-prision/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-prision> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-opus-5-5> .

    <https://w3id.org/laad/id/inferencia/R-prision/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-13"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-13"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-prision> a crminf:I4_Proposition_Set .
}

