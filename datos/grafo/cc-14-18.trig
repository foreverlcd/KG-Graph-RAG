    <https://w3id.org/laad/id/ejercicio-cargo/cargo-chuquitapa-recaudador/vigencia> a crm:E52_Time-Span ;
        crm:P3_has_note "Inicio y fin son las fechas atestiguadas (agosto–noviembre de 1806), no el inicio ni el fin del cargo. Según el denunciante ocultaba tributarios «de muchos años atrás» (UT05), y P14 remite a una denuncia anterior «en once de Febrero del año pasado de 1809» (léase probablemente 1805, F4) que ya iba contra él como recaudador."@es ;
        crm:P82a_begin_of_the_begin "1806-08-01"^^xsd:date ;
        crm:P82b_end_of_the_end "1806-11-30"^^xsd:date .
