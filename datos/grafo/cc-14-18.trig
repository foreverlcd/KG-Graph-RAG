<https://w3id.org/laad/grafo/argumentacion/R-declarante-p19-es-martin> {
    <https://w3id.org/laad/id/creencia/R-declarante-p19-es-martin> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-declarante-p19-es-martin> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-declarante-p19-es-martin> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-opus-5-5> ;
        crm:P17_was_motivated_by <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT12b-001>,
            <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT12b-002>,
            <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT12b-003>,
            <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT12b-005>,
            <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT13-001> ;
        crm:P3_has_note "Al declarante se le muestra «la certificación De folio 4 su firma Martin casorla» y habla de ella en primera persona: mandó a Simón Arce ponerla por escrito, no sabe escribir y «no sabe quien lo transcribio ni firmo su nombre en el papel» (A-UT12b-003): el nombre escrito es el del declarante. En tiempos del Rebelde «era muchacho» (28 años en 1806, unos 2 o 3 en 1780, lectura algo forzada). Un «Gobernador Señor Don», analfabeto, de 28 años y «vecino Español» es anómalo; P05 lo presenta como «soldado granadero», y una abreviatura de «granadero» y «Martin» leída como «Gobernador» y «Mariano» explicaría ambas anomalías (ver R-declarante-p19-gobernador-es-granadero); el testigo «MARIANO FIGUEROA» de la línea anterior pudo favorecer esa lectura. Compite con R-declarante-p19-es-mariano. No se ha cotejado la imagen del folio; la conclusión queda sujeta a ese cotejo. Revisada tras la auditoría I (2026-11-13)."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-declarante-p19-es-martin/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-declarante-p19-es-martin> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-opus-5-5> .

    <https://w3id.org/laad/id/inferencia/R-declarante-p19-es-martin/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-13"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-13"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-declarante-p19-es-martin> a crminf:I4_Proposition_Set .
}

<https://w3id.org/laad/grafo/argumentacion/R-tinta> {
    <https://w3id.org/laad/id/creencia/R-tinta> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-tinta> ;
        crminf:J5_holds_to_be "verdadero" .

    <https://w3id.org/laad/id/inferencia/R-tinta> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-opus-5-5> ;
        crm:P3_has_note "Pueblo de Tinta, cabecera del partido homónimo («En el pueblo de Tinta, en primero de agosto de 1806»). HGIS de las Indias src_id 6000357 (WHG 177060; -71.406, -14.145; jurisdicción de Tinta 1701–1808), Wikidata Q2435935 y TGN 9227290 (P1667 del elemento de Wikidata), verificados por la auditoría I. Se descartan los homónimos Tinta de Cajatambo (6000993) y Tintay. El texto usa «Tinta» con cuatro referentes que no deben fusionarse con este: el pueblo; el partido («partido de este nombre», «partido de Tinta»; WHG 139803); la «compañía de Tinta de Milicias» o «regimiento de Tinta»; y el «Ayllu Tinta». Revisada tras la auditoría I (2026-11-13)."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-tinta/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-tinta> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-opus-5-5> .

    <https://w3id.org/laad/id/inferencia/R-tinta/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-13"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-13"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-tinta> a crminf:I4_Proposition_Set .
}

