<https://w3id.org/laad/grafo/reconstruccion/R-cargo-chuquitapa-cacique> {
    <https://w3id.org/laad/id/ejercicio-cargo/cargo-chuquitapa-cacique/titular> a crm:PC14_carried_out_by ;
        crm:P01_has_domain <https://w3id.org/laad/id/ejercicio-cargo/cargo-chuquitapa-cacique> ;
        crm:P02_has_range <https://w3id.org/laad/id/persona/chuquitapa> ;
        crm:P14.1_in_the_role_of cargo:cacique .

    <https://w3id.org/laad/id/ejercicio-cargo/cargo-chuquitapa-cacique> a crm:E7_Activity ;
        rdfs:label "Andrés Chuquitapa, llamado y tratado como cacique en 1806"@es ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/persona/chuquitapa> ;
        crm:P2_has_type cargo:cacique ;
        crm:P4_has_time-span <https://w3id.org/laad/id/ejercicio-cargo/cargo-chuquitapa-cacique/vigencia> ;
        prov:wasDerivedFrom <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT02-304>,
            <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT16b-001> ;
        prov:wasGeneratedBy <https://w3id.org/laad/id/inferencia/R-cargo-chuquitapa-cacique> .

    <https://w3id.org/laad/id/ejercicio-cargo/cargo-chuquitapa-cacique/vigencia> a crm:E52_Time-Span ;
        crm:P3_has_note "Consta en 1806 (carátula UT00; certificación P03: «los indios del cacique don Andrés Chukitapa»; informe del cura). Ninguna pieza dice que fuera cacique en tiempos de Reparaz: P03 lo llama cacique en presente y le atribuye un hecho pasado."@es ;
        crm:P82a_begin_of_the_begin "1806-01-01"^^xsd:date ;
        crm:P82b_end_of_the_end "1806-12-31"^^xsd:date .
}

