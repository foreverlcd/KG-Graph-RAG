            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-opus-5-5> ;
        crm:P17_was_motivated_by <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT17-001>,
