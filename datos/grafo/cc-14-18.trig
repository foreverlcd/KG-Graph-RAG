    <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT19-802/valor> a crm:E33_Linguistic_Object ;
        crm:P190_has_symbolic_content "hasiendole asi mismo extender la subordinación y respeto que debe observar en lo sucesivo con los superiores" .

    <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT19-803/valor> a crm:E33_Linguistic_Object ;
        crm:P190_has_symbolic_content "bajo apersivimiento ... Tomará el gobierno las más serias providencias" .

    <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT19-805/valor> a crm:E33_Linguistic_Object ;
        crm:P190_has_symbolic_content "excesos y enemistad" .

    <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT19-811/valor> a crm:E33_Linguistic_Object ;
        crm:P190_has_symbolic_content "en odio de los denuncios de Yndios tributarios que hizo contra dicho recaudador" .

    <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT19-812/valor> a crm:E33_Linguistic_Object ;
        crm:P190_has_symbolic_content "la malicia con que aparece aver formado dicha queja" .

    <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT19-813/valor> a crm:E33_Linguistic_Object ;
        crm:P190_has_symbolic_content "los enemistad que se advierte profesarle al mencionado recaudador" .

    <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT19-814/valor> a crm:E33_Linguistic_Object ;
        crm:P190_has_symbolic_content "tome las providencias que según su prudencia y conocimientos en el asunto estime mas oportuno y conducentes a efecto de corregir y contener del yndio Guancachoque" .

