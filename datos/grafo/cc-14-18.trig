<https://w3id.org/laad/grafo/argumentacion/R-mata> {
    <https://w3id.org/laad/id/inferencia/R-mata> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-opus-5-5> ;
        crm:P3_has_note "Juez comisionado que recibe las declaraciones «a falta de Escribano» y firma el informe de Sicuani. Incluye «el grl. sub delegado» ante quien declara Orue (P21), las variantes «Pedro de la Mara» (P14, P16) y «pedro de Mata[Firma]» (P22), el destinatario «Al subdelegado de Tinta» (P13), que recibe esa orden y la cumple en P14 («se me remitio ami el subdelegado»), y «subdelegado del partido de tinta» (P28, 26-11-1806). Esta última y la de P13 son referencias al cargo, no al nombre: lo más probable es que siga siendo Mata (firmó el informe del 8 de noviembre), y por esa reserva la reconstrucción queda en probable. Revisada tras la auditoría I (2026-11-13)."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-mata/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-mata> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-opus-5-5> .

    <https://w3id.org/laad/grafo/reconstruccion/R-mata> a crminf:I4_Proposition_Set .

    <https://w3id.org/laad/id/creencia/R-mata> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-mata> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-mata/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-13"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-13"^^xsd:date .
}

