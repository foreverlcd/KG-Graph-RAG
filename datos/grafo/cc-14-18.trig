<https://w3id.org/laad/grafo/argumentacion/R-chiquitas> {
    <https://w3id.org/laad/id/creencia/R-chiquitas> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-chiquitas> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-chiquitas> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-opus-5-5> ;
        crm:P17_was_motivated_by <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT15-001> ;
        crm:P3_has_note "En la misma declaración Orue dice que Chuquitapa «no es tan malo ni de boca tan mordaz como la spa su mujer»; en el mismo período «su mujer» remite a la mujer de Chuquitapa, y la frase presenta la mordacidad de esa mujer como el motivo del enojo, de modo que «la mujer de Chiquitas» y «su mujer» son la misma mujer. UT14–UT15 es un tramo de transcripción muy deteriorada (guancachay, chuquitaza, cacerola), así que «Chiquitas» por «Chuquitapa» es una mala lectura verosímil. Se mantiene separada de R-chuquitapa: la fusión de M-UT15-001 solo procedería tras cotejar la imagen, que no se ha hecho. Revisada tras la auditoría I (2026-11-13)."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-chiquitas/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-chiquitas> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-opus-5-5> .

    <https://w3id.org/laad/id/inferencia/R-chiquitas/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-13"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-13"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-chiquitas> a crminf:I4_Proposition_Set .
}

<https://w3id.org/laad/grafo/argumentacion/R-rubrica-es-media-rubrica> {
    <https://w3id.org/laad/id/creencia/R-rubrica-es-media-rubrica> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-rubrica-es-media-rubrica> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-rubrica-es-media-rubrica> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-opus-5-5> ;
        crm:P3_has_note "Aparece dos veces entre corchetes al pie de los decretos de UT17 (P24, P25), que es la convención del transcriptor para sus notas; «media rúbrica» es la fórmula diplomática habitual de los decretos autorizados con media firma. Compatible con R-rubrica-es-mata (quién rubrica). No se ha cotejado la imagen del folio; la conclusión queda sujeta a ese cotejo. Creada tras la auditoría I (2026-11-13), como propuesta del modelo."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-rubrica-es-media-rubrica/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-rubrica-es-media-rubrica> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-opus-5-5> .

    <https://w3id.org/laad/id/inferencia/R-rubrica-es-media-rubrica/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-13"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-13"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-rubrica-es-media-rubrica> a crminf:I4_Proposition_Set .
}

<https://w3id.org/laad/grafo/argumentacion/R-juan-cazorla> {
