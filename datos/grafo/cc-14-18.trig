    <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT09-511/valor> a crm:E33_Linguistic_Object ;
        crm:P190_has_symbolic_content "oyendo sobre ellos al Apoderado Fiscal ynforme por ceparado" .

    <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT09-516/valor> a crm:E33_Linguistic_Object ;
