        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-quinones-nombre-puesto-por-redactor> ;
        crminf:J5_holds_to_be "posible" .

    <https://w3id.org/laad/id/inferencia/R-quinones-nombre-puesto-por-redactor> a crminf:I5_Inference_Making,
            prov:Activity ;
