            <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT17-003>,
            <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT19-806> ;
        crm:P3_has_note "Lo afirman el denunciante, el fiscal y el subdelegado, con intereses opuestos en la causa, y lo repiten el auto (P10), el oficio del Presidente (P13), la providencia del subdelegado (P14), el informe (P27) y el auto final (P28); ninguna pieza lo discute. Revisada tras la auditoría I (2026-11-13)."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-cargo-chuquitapa-recaudador/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-cargo-chuquitapa-recaudador> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-opus-5-5> .

    <https://w3id.org/laad/grafo/reconstruccion/R-cargo-chuquitapa-recaudador> a crminf:I4_Proposition_Set .

    <https://w3id.org/laad/id/creencia/R-cargo-chuquitapa-recaudador> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-cargo-chuquitapa-recaudador> ;
        crminf:J5_holds_to_be "verdadero" .

    <https://w3id.org/laad/id/inferencia/R-cargo-chuquitapa-recaudador/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-13"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-13"^^xsd:date .
}

<https://w3id.org/laad/grafo/argumentacion/R-cura-valdes> {
    <https://w3id.org/laad/grafo/reconstruccion/R-cura-valdes> a crminf:I4_Proposition_Set .

    <https://w3id.org/laad/id/creencia/R-cura-valdes> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-cura-valdes> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-cura-valdes> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-opus-5-5> ;
        crm:P3_has_note "El oficio P22 se dirige al «parroco interino de esta doctrina»; el informe de Mata (P27) llama al autor del informe «cura interino de dicho Pueblo Doctor Don Agustin Valdes». La identificación es directa y del mismo autor, pero la única fuente es Mata y la firma del informe no está transcrita («Firma»); además, P23 lleva la fecha imposible 26 de noviembre (nota F5 de fechas_normalizadas.csv), así que no es seguro que el informe citado el 8 de noviembre sea este. No es «Doctor Don Antonio Valdes», tío del interino según P22 (ver R-antonio-valdes-cura-propietario). Revisada tras la auditoría I (2026-11-13)."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-cura-valdes/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-cura-valdes> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-opus-5-5> .

    <https://w3id.org/laad/id/inferencia/R-cura-valdes/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-13"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-13"^^xsd:date .
}

