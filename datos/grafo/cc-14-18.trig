<https://w3id.org/laad/grafo/argumentacion/R-orue> {
    <https://w3id.org/laad/id/inferencia/R-orue> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-opus-5-5> ;
        crm:P17_was_motivated_by <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT14-001>,
            <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT14-002>,
            <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT14-003> ;
        crm:P3_has_note "Se le pregunta en P21 si «la firma q dise fernando orue» de la certificación es suya y responde sobre ella en primera persona («no obstante que sabe firmar el declarante no quiso hacerlo»): la certificación se extendió a su nombre. Sobre quién la escribió o firmó, P21 da tres versiones incompatibles: «bajo a un hijo suyo q la pusieron» (A-UT14-002), «como ha puesto guasscachoque en la citada certificacion» (A-UT14-003) y «mando que un hijo suyo lo hicieron»; eso afecta a la autoría material, no a la identidad. Revisada tras la auditoría I (2026-11-13)."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-orue/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-orue> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-opus-5-5> .

    <https://w3id.org/laad/id/creencia/R-orue> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-orue> ;
        crminf:J5_holds_to_be "verdadero" .

    <https://w3id.org/laad/id/inferencia/R-orue/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-13"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-13"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-orue> a crminf:I4_Proposition_Set .
}

