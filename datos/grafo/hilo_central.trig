    <https://w3id.org/laad/id/cc-14-18/anotacion/A-UT19-001/cita> a oa:TextQuoteSelector ;
        oa:exact "resultando de este ser menos conforme a la verdad las quejas dadas por Manuel Guancoichoque" .

    <https://w3id.org/laad/id/cc-14-18/anotacion/A-UT19-001/objetivo> a oa:SpecificResource ;
