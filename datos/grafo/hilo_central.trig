    <https://w3id.org/laad/id/cc-14-18/anotacion/A-UT18-001/cita> a oa:TextQuoteSelector ;
        oa:exact "que lo guardasen en ella esa misma noche, al que puse en libertad al otro dia por la tarde" .

    <https://w3id.org/laad/id/cc-14-18/anotacion/A-UT18-001/objetivo> a oa:SpecificResource ;
