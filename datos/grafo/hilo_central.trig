    <https://w3id.org/laad/id/cc-14-18/anotacion/A-UT19-002/cita> a oa:TextQuoteSelector ;
        oa:exact "por la mala conducta y genio discolo y arreva que se nota" .

    <https://w3id.org/laad/id/cc-14-18/anotacion/A-UT19-002/objetivo> a oa:SpecificResource ;
