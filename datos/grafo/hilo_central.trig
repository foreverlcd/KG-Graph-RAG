    <https://w3id.org/laad/id/cc-14-18/anotacion/A-UT18-003/cita> a oa:TextQuoteSelector ;
        oa:exact "falta de Religion, altanería , enemigo de la paz y sosiego" .

    <https://w3id.org/laad/id/cc-14-18/anotacion/A-UT18-003/objetivo> a oa:SpecificResource ;
