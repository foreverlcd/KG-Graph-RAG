            <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT12b-005>,
            <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT13-001> ;
        crm:P3_has_note "Al declarante se le muestra «la certificación De folio 4 su firma Martin casorla» y habla de ella en primera persona: mandó a Simón Arce ponerla por escrito, no sabe escribir, y en tiempos del Rebelde «era muchacho» (28 años en 1806, unos 2 en 1780). La denominación «Gobernador Señor Don Mariano Casorla» puede ser un error del escribano o de la transcripción. Compite con R-declarante-p19-es-mariano."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-declarante-p19-es-martin/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-declarante-p19-es-martin> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-opus-5-5> .

    <https://w3id.org/laad/grafo/reconstruccion/R-declarante-p19-es-martin> a crminf:I4_Proposition_Set .

    <https://w3id.org/laad/id/creencia/R-declarante-p19-es-martin> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-declarante-p19-es-martin> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-declarante-p19-es-martin/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-12"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-12"^^xsd:date .
}

