    <https://w3id.org/laad/id/cc-14-18/anotacion/A-UT18-002/cita> a oa:TextQuoteSelector ;
        oa:exact "lo mande llevar a la cárcel" .

    <https://w3id.org/laad/id/cc-14-18/anotacion/A-UT18-002/objetivo> a oa:SpecificResource ;
        oa:hasSelector <https://w3id.org/laad/id/cc-14-18/anotacion/A-UT18-002/cita>,
