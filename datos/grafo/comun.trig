<https://w3id.org/laad/grafo/argumentacion/R-juan-de-dios-cazorla> {
    <https://w3id.org/laad/id/creencia/R-juan-de-dios-cazorla> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-juan-de-dios-cazorla> ;
        crminf:J5_holds_to_be "verdadero" .

    <https://w3id.org/laad/id/inferencia/R-juan-de-dios-cazorla> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "«mi hermano juan de dios casorlas» (UT13) y «mi hermano Juan se Dios cazorla» (UT14) son la misma frase de la declaración P20, que la transcripción trae dos veces (fin de un folio y comienzo del siguiente). No se pronuncia sobre de quién es hermano (la frase mezcla el estilo directo de quien avisa con el del declarante) ni sobre si es el firmante de P03: eso es la hipótesis R-juan-cazorla-es-juan-de-dios (ver R-juan-cazorla)."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-juan-de-dios-cazorla/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-juan-de-dios-cazorla> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/id/inferencia/R-juan-de-dios-cazorla/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-juan-de-dios-cazorla> a crminf:I4_Proposition_Set .
}

<https://w3id.org/laad/grafo/argumentacion/R-espanoles-tinta> {
    <https://w3id.org/laad/id/creencia/R-espanoles-tinta> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-espanoles-tinta> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-espanoles-tinta> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "El vecindario español de Tinta, contra el que según los certificantes se dirigía el alzamiento: «hacen una matanza a los españoles» (UT01); «despues pasar a los españoles», «todos los españoles tuvimos por bien hecho» (UT02); «ninguno estamos libres de su traición los españoles» (UT03). Las declaraciones repiten la frase de Cano al preguntar por ella: «hacer matalo de los españoles poniendo guardias» (UT11), «hace una matanza a contra los españoles poniendo guardias» (UT13), «haser matanza de los españoles poniendo guardias» (UT14). Los declarantes se dicen «vecino Español de este … pueblo». Es un colectivo de extensión imprecisa, no un cuerpo: «probable». «dos españoles» (UT02) queda fuera por ser un subconjunto indeterminado."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-espanoles-tinta/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-espanoles-tinta> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/id/inferencia/R-espanoles-tinta/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-espanoles-tinta> a crminf:I4_Proposition_Set .
}

<https://w3id.org/laad/grafo/argumentacion/R-compania-tinta> {
    <https://w3id.org/laad/id/creencia/R-compania-tinta> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-compania-tinta> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-compania-tinta> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "«Yo el sargento Don Isidro Cano de esta compañía de Tinta de Milicias de este cuerpo» (UT01) y «Yo el cabo primero en esta compañía de Tinta de este mismo cuerpo» (UT03, a nombre de Fernando Orue): mismo nombre y misma fórmula. La segunda calca la primera (el subdelegado atribuye las certificaciones a un mismo redactor, UT17), de modo que la coincidencia verbal no es prueba independiente: «probable». Es una compañía, no el pueblo ni el regimiento."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-compania-tinta/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-compania-tinta> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/id/inferencia/R-compania-tinta/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-compania-tinta> a crminf:I4_Proposition_Set .
}

