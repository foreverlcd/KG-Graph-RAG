<https://w3id.org/laad/grafo/argumentacion/R-mujer-de-chuquitapa> {
    <https://w3id.org/laad/id/creencia/R-mujer-de-chuquitapa> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-mujer-de-chuquitapa> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-mujer-de-chuquitapa> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "En el mismo período de P21: «la mujer de Chiquitas habla contra el que declara y su familia, lo que le encolerizo … que chuquitapa no es tan malo ni de boca tan mordaz como la spa su mujer». La mordacidad de «su mujer» es el motivo del enojo que acaba de contar, de modo que es la misma mujer. Que sea la mujer de Andrés Chuquitapa depende de leer «Chiquitas» como «Chuquitapa» (R-chiquitas, R-chuquitapa), que sigue sin cotejar con el folio. No es «su mujer resien parida» de P01, que es la de Orey."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-mujer-de-chuquitapa/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-mujer-de-chuquitapa> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/id/inferencia/R-mujer-de-chuquitapa/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-mujer-de-chuquitapa> a crminf:I4_Proposition_Set .
}

<https://w3id.org/laad/grafo/argumentacion/R-quinones-nombre-puesto-por-redactor> {
