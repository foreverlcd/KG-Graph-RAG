<https://w3id.org/laad/grafo/argumentacion/R-chuquitapa-1780-pariente> {
    <https://w3id.org/laad/id/creencia/R-chuquitapa-1780-pariente> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-chuquitapa-1780-pariente> ;
        crminf:J5_holds_to_be "posible" .

    <https://w3id.org/laad/id/inferencia/R-chuquitapa-1780-pariente> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P17_was_motivated_by <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT11-003>,
            <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT11-004>,
            <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT14-006>,
            <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT14-007> ;
        crm:P3_has_note "Hipótesis rival de R-chuquitapa para las tres menciones que atribuyen al cacique hechos anteriores a 1780. Que el mismo individuo fuera agitador antes de la rebelión, coronel o comisionado de Túpac Amaru y, 26 años después, cacique y recaudador tras la represión de 1781–1784 no es imposible, pero es llamativo; los testigos son hostiles al cacique y Cano rebaja su propia certificación («Comisionado por este y no coronel», UT11). El texto no nombra a ningún pariente: es una inferencia, no un dato. Creada tras la auditoría I (2026-11-13), como propuesta del modelo. Ampliada el 2026-11-14 (claude-fable-5-2): se añaden tres menciones que también atribuyen hechos anteriores a 1780: «Este mismo cacique invento el alzamiento contra don Miguel Orey» («muy antes de la rebelion», P03) y, en P21, el episodio «en tiempo del sor corregidor d juan antonio repuras» («corral de chuquitapa», «el dicho chuquitapa»). Siguen también en R-chuquitapa, de la que esta es rival. La lectura «Don Andres» de P18 como Chuquitapa (R-don-andres-p18-es-chuquitapa) se apoya en M-UT01-004, que está en ambas. Reconstrucción propuesta originalmente por claude-opus-5-5 el 2026-11-13."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-chuquitapa-1780-pariente/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-chuquitapa-1780-pariente> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/id/inferencia/R-chuquitapa-1780-pariente/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-chuquitapa-1780-pariente> a crminf:I4_Proposition_Set .
}

<https://w3id.org/laad/grafo/argumentacion/R-casa-matricula-tinta> {
