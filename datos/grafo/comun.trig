<https://w3id.org/laad/grafo/argumentacion/R-don-andres-p18-es-chuquitapa> {
    <https://w3id.org/laad/id/creencia/R-don-andres-p18-es-chuquitapa> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-don-andres-p18-es-chuquitapa> ;
        crminf:J5_holds_to_be "posible" .

    <https://w3id.org/laad/id/inferencia/R-don-andres-p18-es-chuquitapa> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "La frase de P01 que Cano ratifica es «En tiempo del señor corregidor don Antonio Reparas, mando dicho Chuquitapa»: en P18, «en tiempo de corregidor Don Andres ……» puede haber perdido el nombre del corregidor y conservar el del sujeto, Don Andrés [Chuquitapa]; el único Andrés de la causa es él y la frase siguiente habla de él («en tiempo del rebelde Tupa amaro fue Comisionado»). Rival de R-don-andres-p18-es-reparaz; ver R-chuquitapa (y su rival R-chuquitapa-1780-pariente, que comparte M-UT01-004) y R-reparaz. No hay imagen del folio: la laguna impide decidir."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-don-andres-p18-es-chuquitapa/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-don-andres-p18-es-chuquitapa> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/id/inferencia/R-don-andres-p18-es-chuquitapa/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-don-andres-p18-es-chuquitapa> a crminf:I4_Proposition_Set .
}

<https://w3id.org/laad/grafo/argumentacion/R-certificaciones-presentadas> {
    <https://w3id.org/laad/id/creencia/R-certificaciones-presentadas> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-certificaciones-presentadas> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-certificaciones-presentadas> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "El conjunto de documentos presentados en apoyo de la queja: «este hecho parece que lo califican con las certificaciones de testigos que acompañan a su escrito» (UT07); «los Documentos que presento Manuel Guancachoque sobre el bullicio, y asonada … fueron hechos por el mismo Guancachoque haciéndolos firmar a los sujetos que los subscriben» (UT17); «dicha queja y los documentos que presento en su calificación» (UT19). Con menos seguridad: «en el supuesto de tener yo documentos calificativos del hecho que refiero» (UT06), que anuncia en el propio escrito los documentos que luego «acompañan» a este; y «se acompañan en las fojas antecedentes» (UT09), donde lo mencionado son las fojas que contienen las certificaciones cuyos firmantes deben ratificarse. Es un conjunto: cada certificación tiene su reconstrucción aparte cuando hay más de una mención."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-certificaciones-presentadas/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-certificaciones-presentadas> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/id/inferencia/R-certificaciones-presentadas/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-certificaciones-presentadas> a crminf:I4_Proposition_Set .
}

