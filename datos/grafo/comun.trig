<https://w3id.org/laad/grafo/argumentacion/R-auto-26-noviembre> {
    <https://w3id.org/laad/id/inferencia/R-auto-26-noviembre> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "«hacia presente el entendido del Auto marginal presedente al señor don Lucio Gonzalo del Rio» (26 de noviembre) y «habiendo llegado a la ciudad a preguntar por el proveido antecedente hace saber el contento del Auto de arriba» (UT20). En la segunda notificación «el proveido antecedente» y «el Auto de arriba» son el mismo proveído; que sea el mismo de la primera se sigue del orden de las diligencias, pero la segunda lleva fecha anómala («mil ochocientos 10 años») y no dice a quién se notifica: «probable»."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-auto-26-noviembre/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-auto-26-noviembre> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/grafo/reconstruccion/R-auto-26-noviembre> a crminf:I4_Proposition_Set .

    <https://w3id.org/laad/id/creencia/R-auto-26-noviembre> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-auto-26-noviembre> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-auto-26-noviembre/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .
}

<https://w3id.org/laad/grafo/argumentacion/R-quinones> {
    <https://w3id.org/laad/id/inferencia/R-quinones> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-opus-5-5> ;
        crm:P17_was_motivated_by <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT17-002> ;
        crm:P3_has_note "La certificación P03 está extendida a su nombre, pero el juez afirma que «no hay tal hombre en el pueblo de Tinta» (A-UT17-002). El juez no dice que la firmara Juan Cazorla en P24 («Juan Cazorla de quien aparece firmada la Certificación»); la atribución expresa está en P25 («Juan Cazorla que suscribió el documento de 2 fojas»). Esta reconstrucción trata solo de la existencia; que las dos menciones designan el mismo nombre está en R-quinones-nombre. Hipótesis rivales: R-quinones-nombre-puesto-por-redactor (H1) y R-quinones-real-no-residente (H2). No se fusiona con Juan Cazorla. Revisada tras la auditoría I (2026-11-13)."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-quinones/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-quinones> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-opus-5-5> .

    <https://w3id.org/laad/grafo/reconstruccion/R-quinones> a crminf:I4_Proposition_Set .

    <https://w3id.org/laad/id/creencia/R-quinones> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-quinones> ;
        crminf:J5_holds_to_be "indeterminado" .

    <https://w3id.org/laad/id/inferencia/R-quinones/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-13"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-13"^^xsd:date .
}

