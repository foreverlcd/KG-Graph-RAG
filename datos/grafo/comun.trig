<https://w3id.org/laad/grafo/argumentacion/R-huancachoque-alias-ortiz> {
    <https://w3id.org/laad/id/inferencia/R-huancachoque-alias-ortiz> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "El cura escribe «representaciones o diosas de Ortis o Guancachoque» (UT16.b) después de presentar al denunciante como «hijo Espurio de Antolin Ortiz» (UT16.a): la disyunción «o» une dos nombres del mismo individuo, el apellido del padre que le atribuye y el suyo. «Maldonado Ortiz» (misma pieza) queda fuera por ambiguo. Creada tras la auditoría I (2026-11-13), como propuesta del modelo. Ampliada el 2026-11-14 (claude-fable-5-2): sin cambios en las menciones; se anota que es hipótesis complementaria de R-huancachoque (con la que comparte sus tres menciones) y que el padre atribuido está ahora en R-antolin-ortiz. Reconstrucción propuesta originalmente por claude-opus-5-5 el 2026-11-13."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-huancachoque-alias-ortiz/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-huancachoque-alias-ortiz> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/id/creencia/R-huancachoque-alias-ortiz> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-huancachoque-alias-ortiz> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-huancachoque-alias-ortiz/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-huancachoque-alias-ortiz> a crminf:I4_Proposition_Set .
}

