<https://w3id.org/laad/grafo/argumentacion/R-cargo-chuquitapa-alcalde-mayor> {
    <https://w3id.org/laad/id/inferencia/R-cargo-chuquitapa-alcalde-mayor> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-opus-5-5> ;
        crm:P17_was_motivated_by <https://w3id.org/laad/id/cc-14-18/afirmacion/A-UT16b-002> ;
        crm:P3_has_note "Solo lo dice el cura («su casique y alcalde mayor Don Andres Chuquitapa», P23). Su hostilidad al denunciante pesa en sus juicios de conducta, no en un título de tratamiento que nadie discute y que no le aporta nada; y encaja con la jerarquía que describen otras piezas («los segundas, los alcaldes, sus parientes», UT05; «los Alcaldes. Segundas, y Principales de los citados Ayllus de Chuquitapa», UT17–UT18). Se trata del alcalde mayor de naturales del cabildo indígena, no del alcalde mayor español; el concepto cargo:alcalde-mayor del tesauro ya es «alcalde mayor (de indios)». Revisada tras la auditoría I (2026-11-13)."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-cargo-chuquitapa-alcalde-mayor/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-cargo-chuquitapa-alcalde-mayor> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-opus-5-5> .

    <https://w3id.org/laad/id/creencia/R-cargo-chuquitapa-alcalde-mayor> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-cargo-chuquitapa-alcalde-mayor> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-cargo-chuquitapa-alcalde-mayor/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-13"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-13"^^xsd:date .

