<https://w3id.org/laad/grafo/argumentacion/R-tupac-amaru> {
    <https://w3id.org/laad/grafo/reconstruccion/R-tupac-amaru> a crminf:I4_Proposition_Set .

    <https://w3id.org/laad/id/creencia/R-tupac-amaru> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-tupac-amaru> ;
        crminf:J5_holds_to_be "verdadero" .

    <https://w3id.org/laad/id/inferencia/R-tupac-amaru> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-opus-5-5> ;
        crm:P3_has_note "«Joseph Condorcanqui alias Tupac Amaro» (UT16.a) es inequívoco; «Tupa Amaro», «Tupaamaro», «Tupa amaro», «tupa-amaru», «insurgente tupa», «el Rebelde» y «vuestro Condorcanqui», junto a «el rebelde» y «el insurgente» y en el contexto de Tinta (su antiguo cacicazgo y escenario de 1780), también lo son. La única alternativa teórica, Diego Cristóbal Túpac Amaru (que dirigió la rebelión tras abril de 1781), es improbable en este contexto; no se registra como reconstrucción aparte. Wikidata Q315937 (Túpac Amaru II, 1738–1781), comprobado en la API el 2026-11-13. Revisada tras la auditoría I (2026-11-13)."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-tupac-amaru/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-tupac-amaru> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-opus-5-5> .

    <https://w3id.org/laad/id/inferencia/R-tupac-amaru/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-13"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-13"^^xsd:date .
}

<https://w3id.org/laad/grafo/argumentacion/R-matricula-huancachoque> {
    <https://w3id.org/laad/id/inferencia/R-matricula-huancachoque> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "«se le borre de la matricula en que lo han numerado en clase tributarios» (carátula, UT00) resume la súplica del escrito: «se me saque de la matricula relevándoseme de la contribución del tributo» (UT06). Es la matrícula de la nueva revisita («matriculados en la nueba revisita», UT11). No se funde con la «matrícula» de la que estaban fuera los tributarios ocultos (R-matricula-ocultos), que en rigor es el padrón anterior."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-matricula-huancachoque/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-matricula-huancachoque> ;
