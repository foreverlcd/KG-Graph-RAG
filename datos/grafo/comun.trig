<https://w3id.org/laad/grafo/argumentacion/R-plaza-tinta> {
    <https://w3id.org/laad/id/creencia/R-plaza-tinta> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-plaza-tinta> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-plaza-tinta> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "La plaza donde, según los certificantes, se juntaron los indios la noche de la prisión de Huancachoque: «estaba cubierto de indiada la plaza» (UT01); «cuasi lo acaban en las calles públicas y plaza», «se alzaron los indios en la plaza», «en cada esquina de esta plaza» (UT02); «todos ebrios al redor de la plaza» (UT03). Las certificaciones se dan en Tinta (UT01, UT02) y narran el mismo hecho; «esta plaza» supone que el certificante escribe en el pueblo. El texto no la nombra: «probable»."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-plaza-tinta/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-plaza-tinta> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/id/inferencia/R-plaza-tinta/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-plaza-tinta> a crminf:I4_Proposition_Set .
}

