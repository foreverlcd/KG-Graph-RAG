<https://w3id.org/laad/grafo/argumentacion/R-certificacion-martin-cazorla> {
    <https://w3id.org/laad/id/creencia/R-certificacion-martin-cazorla> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-certificacion-martin-cazorla> ;
