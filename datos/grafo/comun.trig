    <https://w3id.org/laad/id/inferencia/R-real-audiencia-cusco> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "«de orden del muy ilustre señor presidente que esta Real Audiencia» (escrito datado «CUSCO», UT05) y «su fiscal en esta Real Audiencia» (notificación hecha «En el Cusco», UT08): «esta» remite al lugar de redacción de ambas piezas, la ciudad sede del tribunal. Wikidata Q2134673 («Real Audiencia del Cuzco», alto tribunal español), comprobado en la API de Wikidata el 2026-11-14. HGIS registra el distrito de la Audiencia (AUCU0000, WHG 139281, 1788–1808), que es un territorio y no el tribunal: no se usa como identificador de este grupo."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-real-audiencia-cusco/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-real-audiencia-cusco> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/id/inferencia/R-real-audiencia-cusco/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .

