<https://w3id.org/laad/grafo/argumentacion/R-carcel-tiempo-reparaz> {
    <https://w3id.org/laad/id/creencia/R-carcel-tiempo-reparaz> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-carcel-tiempo-reparaz> ;
