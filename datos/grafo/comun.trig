<https://w3id.org/laad/grafo/argumentacion/R-regio-senado-es-real-audiencia> {
    <https://w3id.org/laad/id/inferencia/R-regio-senado-es-real-audiencia> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "Hipótesis. El cura pide que su informe se «pueda exponer a aquel Regio sonado nodudando y como oraculos de la ley sabran comtrapesar … as representaciones o diosas de Ortis o Guancachoque» (UT16.b). «Regio sonado» se lee como «Regio Senado», tratamiento usual de una Audiencia, y lo de oráculos de la ley conviene a sus ministros; el asunto se ventila ante el presidente y el fiscal de «esta Real Audiencia» (UT05, UT08). Pero la lectura es conjetural y la causa se tramita en rigor en el Gobierno e Intendencia (R-gobierno-cusco), no en la sala de la Audiencia: queda en «posible»."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-regio-senado-es-real-audiencia/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-regio-senado-es-real-audiencia> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/id/creencia/R-regio-senado-es-real-audiencia> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-regio-senado-es-real-audiencia> ;
        crminf:J5_holds_to_be "posible" .

    <https://w3id.org/laad/id/inferencia/R-regio-senado-es-real-audiencia/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-regio-senado-es-real-audiencia> a crminf:I4_Proposition_Set .
}

