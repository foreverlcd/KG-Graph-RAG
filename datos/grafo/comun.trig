        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-matricula-huancachoque> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-matricula-huancachoque/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .
}

