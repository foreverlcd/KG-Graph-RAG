<https://w3id.org/laad/grafo/argumentacion/R-hijo-escribiente-p21> {
    <https://w3id.org/laad/id/creencia/R-hijo-escribiente-p21> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-hijo-escribiente-p21> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-hijo-escribiente-p21> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "«le llebo p q firmase dicha certificacion bajo a un hijo suyo q la pusieron» (UT14) y «aunque no lo hise sino mando que un hijo suyo lo hicieron» (UT15): las dos frases de P21 explican quién escribió o firmó la certificación extendida a nombre de Orue, y la segunda («mando») hace al hijo del propio declarante. La primera, en tramo deteriorado, admite que «suyo» remita a otro (el denunciante o el «hermano mayor»); por eso no pasa de probable. Ver R-orue."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-hijo-escribiente-p21/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-hijo-escribiente-p21> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/id/inferencia/R-hijo-escribiente-p21/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-hijo-escribiente-p21> a crminf:I4_Proposition_Set .
}

<https://w3id.org/laad/grafo/argumentacion/R-casa-tienda-orey> {
    <https://w3id.org/laad/id/creencia/R-casa-tienda-orey> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-casa-tienda-orey> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-casa-tienda-orey> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "Cano: contra «el capitan don Miguel Orey … pedrearon su tienda hasta quebrar la puerta unas astillas que hasta hoy esta presente a las tejas hizo polvo» y Orey «escapo por una ventana» (UT01). Certificación a nombre de Quiñones: el alzamiento «contra don Miguel Orey … escaparon por una ventana … a su casa hicieron pedazos la puerta hecho una astilla, las tejas volvieron en tierra que hasta hoy se halla la dicha puerta, hecho astillas» (UT02). Mismo dueño, mismo hecho y mismos detalles (puerta en astillas que aún se ve, tejas, huida por la ventana): es el mismo inmueble, llamado «tienda» en una pieza y «casa» en otra. Las dos certificaciones no son independientes (el subdelegado las atribuye a un mismo redactor, UT17), lo que explica la coincidencia y no la invalida."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-casa-tienda-orey/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-casa-tienda-orey> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/id/inferencia/R-casa-tienda-orey/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-casa-tienda-orey> a crminf:I4_Proposition_Set .
}

