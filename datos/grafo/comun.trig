<https://w3id.org/laad/grafo/argumentacion/R-rubrica-es-mata> {
    <https://w3id.org/laad/grafo/reconstruccion/R-rubrica-es-mata> a crminf:I4_Proposition_Set .

    <https://w3id.org/laad/id/creencia/R-rubrica-es-mata> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-rubrica-es-mata> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-rubrica-es-mata> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "«[María Rubrica]» es con toda probabilidad la nota del transcriptor «[Media rúbrica]» (los corchetes son su convención: «[Firma]», «[Firma Chacon]»), no «Mata [rúbrica]». Los decretos de UT17 los dicta el juez comisionado de la información, que espera a Juan Cazorla «para recibirle la declaración Respectiva» y remite lo actuado «con el correspondiente Informe» al Presidente; ese juez es Pedro de la Mata (P16, P18, P27), que fecha su informe en Sicuani el mismo 8 de noviembre. Ver R-rubrica-es-media-rubrica. No se ha cotejado la imagen del folio; la conclusión queda sujeta a ese cotejo. Revisada tras la auditoría I (2026-11-13). Ampliada el 2026-11-14 (claude-fable-5-2): sin cambios en las menciones; se anota la referencia expresa a R-mata, con la que comparte M-UT18-001 como ancla de la identificación. Reconstrucción propuesta originalmente por claude-opus-5-5 el 2026-11-13."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-rubrica-es-mata/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-rubrica-es-mata> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/id/inferencia/R-rubrica-es-mata/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .
}

