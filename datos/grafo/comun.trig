<https://w3id.org/laad/grafo/argumentacion/R-reparaz> {
    <https://w3id.org/laad/id/inferencia/R-reparaz> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "«señor corregidor don Antonio Reparas» (P01), «señor corregidor Don Juan Antonio Reparas» (P04) y «sor corregidor d juan antonio repuras» (P21): mismo cargo, mismo apellido y mismo episodio (un alzamiento promovido por Chuquitapa antes de la rebelión). «el corregidor» de P21 (M-UT14-528: «se amotinaron contra el corregidor») continúa el relato abierto con «en tiempo del sor corregidor d juan antonio repuras». P01 omite «Juan»; «repuras» está en un tramo de transcripción deteriorada. Queda en probable porque P01 y P04 no son independientes (Mata y el fiscal las atribuyen al denunciante) y la grafía no se ha cotejado con el folio (no hay imágenes). «corregidor Don Andres» de P18 se trata aparte: R-don-andres-p18-es-reparaz frente a R-don-andres-p18-es-chuquitapa."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-reparaz/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-reparaz> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/grafo/reconstruccion/R-reparaz> a crminf:I4_Proposition_Set .

    <https://w3id.org/laad/id/creencia/R-reparaz> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-reparaz> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-reparaz/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .
}

