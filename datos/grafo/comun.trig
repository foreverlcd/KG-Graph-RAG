}

<https://w3id.org/laad/grafo/argumentacion/R-declarante-p19-es-mariano> {
    <https://w3id.org/laad/id/inferencia/R-declarante-p19-es-mariano> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-opus-5-5> ;
        crm:P3_has_note "Único apoyo: la lectura literal «el Gobernador Señor Don Mariano Casorla», con un tratamiento que es anómalo por sí mismo (un «Gobernador» vecino español y analfabeto). En contra: el declarante habla en primera persona de la certificación de Martín («mando el que declara a Simon Arce»), dice que no sabe quién «firmo su nombre», declara 28 años y no sabe escribir. La variante más defendible de esta hipótesis sería un pariente que responde por Martín, pero choca con esos mismos datos. No se ha cotejado la imagen del folio; la conclusión queda sujeta a ese cotejo. Revisada tras la auditoría I (2026-11-13)."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-declarante-p19-es-mariano/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-declarante-p19-es-mariano> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-opus-5-5> .

    <https://w3id.org/laad/id/creencia/R-declarante-p19-es-mariano> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-declarante-p19-es-mariano> ;
        crminf:J5_holds_to_be "improbable" .

    <https://w3id.org/laad/id/inferencia/R-declarante-p19-es-mariano/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-13"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-13"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-declarante-p19-es-mariano> a crminf:I4_Proposition_Set .
}

