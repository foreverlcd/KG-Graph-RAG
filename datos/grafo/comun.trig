    <https://w3id.org/laad/id/creencia/R-cusco> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-cusco> ;
        crminf:J5_holds_to_be "verdadero" .

    <https://w3id.org/laad/id/inferencia/R-cusco> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "«CUSCO» en la data del escrito presentado ante el Fiscal Protector General. HGIS src_id 6000002 (WHG 176704). Ampliada el 2026-11-14 (registro base de claude-opus-5-5, 2026-11-12) con las datas y localizaciones de las piezas de la capital: «Cusco y Agosto 21 de 1806», «En el Cusco y Agosto veinte y tres», «En la ciudad del Cuzco en trece días», «Cuzco» al pie de las firmas (UT08); «En el Cuzco en veinte y siete días», «Cusco y Agosto 28 de 1806» (UT09); «Cuzco noviembre 18» (UT17); «Cusco y noviembre 26 de 1806» (UT19); «Cuzco y Noviembre 20 de 1806», «En la Ciudad del Cuzco en veinte y seis de noviembre», «En el Cusco en veinte y tres de Diciembre» (UT20). «habiendo llegado a la ciudad» (UT20) se enlaza por antecedente explícito en la misma oración («En el Cusco … habiendo llegado a la ciudad»). La alternancia Cusco/Cuzco es solo gráfica."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-cusco/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-cusco> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/id/inferencia/R-cusco/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-cusco> a crminf:I4_Proposition_Set .
}

