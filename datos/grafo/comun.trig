            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "La diligencia de reconocimiento (P09) se hace «por mi el presente Escribano mayor de Gobierno … de que doy fe», pero entre las firmas transcritas (Galeano, Valencia, Marcos Salcedo, Juan Clemente Jordan, Guancachoque) no está la suya. El escribano que en esos mismos días notifica el decreto (P08) y autoriza el auto del presidente (P10: «Firma Don Antonio Chacón») es Chacón (R-chacon-escribano; rival sobre el nombre: R-chacon-antonio-distinto-de-agustin). Inferencia por oficina y fechas: el texto no une el título de escribano mayor con el apellido."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-escribano-mayor-p09-es-chacon/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-escribano-mayor-p09-es-chacon> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/id/inferencia/R-escribano-mayor-p09-es-chacon/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .

