        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-milicias-provincia-es-regimiento-tinta> ;
        crminf:J5_holds_to_be "posible" .

    <https://w3id.org/laad/id/inferencia/R-milicias-provincia-es-regimiento-tinta/tiempo> a crm:E52_Time-Span ;
