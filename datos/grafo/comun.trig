<https://w3id.org/laad/grafo/argumentacion/R-expediente> {
    <https://w3id.org/laad/id/inferencia/R-expediente> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "«En folio 10 remito a vuestra Merced un expediente relativo a 51 yndios tributarios» (oficio del presidente, UT09); «Por recibida la precedente Orden … con el Expediente en folio 10 que la acompaña», «Desglocese de este Expediente» (providencia del subdelegado, UT10): el mismo legajo de diez folios, enviado y recibido. «antecedente oficio del subdelegado del partido de Tinta … y del Expediente que le acompaña» (vista del fiscal, UT19) es ese legajo de vuelta, ya con la información; que sea el mismo cuaderno acrecido y no otro es inferencia, y de ahí «probable». Se enlazan menciones entre sí: la relación de este objeto con el expediente como unidad archivística o con sus piezas es otro mecanismo. Distinto del «expediente de la primera denuncia» (UT10)."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-expediente/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-expediente> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/id/creencia/R-expediente> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-expediente> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-expediente/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .

    <https://w3id.org/laad/grafo/reconstruccion/R-expediente> a crminf:I4_Proposition_Set .
}

