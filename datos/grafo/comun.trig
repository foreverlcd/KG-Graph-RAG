<https://w3id.org/laad/grafo/argumentacion/R-gobierno-cusco> {
    <https://w3id.org/laad/id/inferencia/R-gobierno-cusco> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "«Tomará el gobierno las más serias providencias. Muñoz [firma]» (auto del presidente, «Cusco y noviembre 26 de 1806») y «la prudente y celosa rectitud de este gobierno» (vista del fiscal al presidente, «Cuzco y Noviembre 20 de 1806»), ambas en UT19 y sobre el mismo asunto: la autoridad gubernativa que resuelve el expediente. Es el «Superior Govierno» que nombra el subdelegado (UT10, sin mención anotada) y el «Govierno e intendencia» de UT08 (mención de clase lugar, R-intendencia-cusco). No se le da identificador externo."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-gobierno-cusco/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-gobierno-cusco> ;
        prov:wasAssociatedWith <https://w3id.org/laad/id/agente/claude-fable-5-2> .

    <https://w3id.org/laad/grafo/reconstruccion/R-gobierno-cusco> a crminf:I4_Proposition_Set .

    <https://w3id.org/laad/id/creencia/R-gobierno-cusco> a crminf:I2_Belief ;
        crminf:J4_that <https://w3id.org/laad/grafo/reconstruccion/R-gobierno-cusco> ;
        crminf:J5_holds_to_be "probable" .

    <https://w3id.org/laad/id/inferencia/R-gobierno-cusco/tiempo> a crm:E52_Time-Span ;
        crm:P82a_begin_of_the_begin "2026-11-14"^^xsd:date ;
        crm:P82b_end_of_the_end "2026-11-14"^^xsd:date .
}

<https://w3id.org/laad/grafo/argumentacion/R-miguel-orey> {
    <https://w3id.org/laad/id/inferencia/R-miguel-orey> a crminf:I5_Inference_Making,
            prov:Activity ;
        crm:P14_carried_out_by <https://w3id.org/laad/id/agente/claude-fable-5-2> ;
        crm:P3_has_note "«el capitan don Miguel Orey» y «el dicho capitán Orey» (P01, anáfora expresa) y «el alzamiento contra don Miguel Orey» (P03): mismo nombre y mismo relato (pedradas, la puerta hecha astillas «que hasta hoy» se ve, las tejas, la huida «por una ventana»). La correferencia es segura; queda en probable porque P01 y P03 no son testimonios independientes y nadie más lo nombra. Hipótesis adicional: R-padre-de-orue-es-miguel-orey."@es ;
        crm:P4_has_time-span <https://w3id.org/laad/id/inferencia/R-miguel-orey/tiempo> ;
        crminf:J2_concluded_that <https://w3id.org/laad/id/creencia/R-miguel-orey> ;
